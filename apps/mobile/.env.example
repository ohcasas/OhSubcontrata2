# Copiar a .env y rellenar con los valores REALES del proyecto de Supabase
# (Project Settings → API, en supabase.com). Este archivo de ejemplo no
# contiene ningún secreto y sí se sube al repositorio; .env NO debe subirse
# nunca (ya está en .gitignore).

EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica-aqui
